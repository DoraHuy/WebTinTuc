// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}


model TaiKhoan {
  id           Int     @id @default(autoincrement())
  taiKhoan     String  @unique
  matKhau      String
  accessToken  String?
  refreshToken String?

  nguoiDung NguoiDungs? @relation("UserAccount")
}

model NguoiDungs {
  id           Int     @id @default(autoincrement())
  tenNguoiDung String
  email        String  @unique
  SDT          String?
  biDanh       String?
  diaChi       String?
  gioiTinh     String?

  tk              String            @unique
  tkNguoiDung     TaiKhoan          @relation("UserAccount", fields: [tk], references: [taiKhoan])
  nguoiDungVaiTro NguoiDungVaiTro[]
  tinTuc          TinTucs[]
  binhLuan        BinhLuans[]
  khoTin          KhoLuuTin[]
  cart            Cart[]
  orders          Order[]
  wallet          Wallet?
  purchasedPosts  PurchasedPost[]
  redeemCodes     RedeemCode[]
  redeemUsages    RedeemCodeUsage[]
  postSubmissions PostSubmission[]
  bookmarks       Bookmark[]
  ratings         Rating[]
  followerOf      Follow[] @relation("FollowerOf")
  author          Follow[] @relation("Author")

  @@map("nguoidungs")
}

model NguoiDungVaiTro {
  ngayNhan    DateTime
  trangThai   Boolean
  ngayHuy     DateTime?
  maNguoiDung Int
  maVaiTro    Int
  nguoiDung   NguoiDungs @relation(fields: [maNguoiDung], references: [id])
  vaiTro      VaiTros    @relation(fields: [maVaiTro], references: [id])

  @@id([maNguoiDung, maVaiTro])
}

model VaiTros {
  id              Int               @id @default(autoincrement())
  tenVaiTro       String            @unique
  moTaVaiTro      String?
  permissions     VaiTroPermision[]
  nguoiDungVaiTro NguoiDungVaiTro[]
}

model Permisions {
  id           Int               @id @default(autoincrement())
  tenPermision String            @unique
  moTa         String?
  vaiTros      VaiTroPermision[]
}

model VaiTroPermision {
  maVaiTro    Int
  maPermision Int
  ngayNhan    DateTime
  trangThai   Boolean
  ngayHuy     DateTime?

  vaiTro    VaiTros    @relation(fields: [maVaiTro], references: [id])
  permision Permisions @relation(fields: [maPermision], references: [id])

  @@id([maVaiTro, maPermision])
}

model DanhMucs {
  id              Int        @id @default(autoincrement())
  tenDanhMuc      String     @unique
  moTaDanhMuc     String?
  thoiGianTao     DateTime   @default(now())
  thoiGianCapNhat DateTime?
  parentId        Int?
  parent          DanhMucs?  @relation("DanhMucCon", fields: [parentId], references: [id])
  children        DanhMucs[] @relation("DanhMucCon")
  tinTuc          TinTucs[]
  postSubmissions PostSubmission[]

  @@map("danhmucs")
}

model KhoLuuTin {
  id           Int        @id
  thoiGianTao  DateTime
  tenKhoLuuTru String     @unique
  moTaKho      String?
  idNguoiDung  Int
  nguoiDung    NguoiDungs @relation(fields: [idNguoiDung], references: [id])
  tinTuc       TinTucs[]
}

model TinTucs {
  id               Int         @id @default(autoincrement())
  tenTinTuc        String
  noiDungTinTuc    String      @db.LongText
  thoiGianDang     DateTime    @default(now())
  trangThaiDuyet   Boolean?
  ngayDang         DateTime    @default(now())
  thoiGianChinhSua DateTime?
  tomTat           String?     @db.MediumText
  maNguoiDung      Int
  nguoiDung        NguoiDungs  @relation(fields: [maNguoiDung], references: [id])
  isPremium        Boolean     @default(false)
  gia              Int?
  danhMuc          DanhMucs[]
  binhLuan         BinhLuans[]
  tags             Tags[]
  khoLuuTin        KhoLuuTin[]
  cart             Cart[]
  orderItems       OrderItem[]
  purchasedPosts   PurchasedPost[]
  bookmarks        Bookmark[]
  ratings          Rating[]
}

model BinhLuans {
  id               Int         @id @default(autoincrement())
  noiDungBinhLuan  String      @db.LongText
  tenNguoiBinhLuan String?
  trangThaiAnDanh  Boolean     @default(false)
  ngayBinhLuan     DateTime    @default(now())
  ngayChinhSua     DateTime?
  parentID         Int?
  parent           BinhLuans?  @relation("BinhLuanCon", fields: [parentID], references: [id])
  binhLuan         BinhLuans[] @relation("BinhLuanCon")
  maNguoiDung      Int
  nguoiDung        NguoiDungs  @relation(fields: [maNguoiDung], references: [id])
  maTinTuc         Int
  tinTuc           TinTucs     @relation(fields: [maTinTuc], references: [id])
}

model HinhAnhVideos {
  id       Int      @id @default(autoincrement())
  url      String   @unique @db.VarChar(255)
  type     String
  mimeType String?
  size     Int
  ngayTao  DateTime @default(now())
}

model Tags {
  id     Int       @id @default(autoincrement())
  tenTag String
  tinTuc TinTucs[]
}

// Giỏ hàng
model Cart {
  id          Int      @id @default(autoincrement())
  maNguoiDung Int
  nguoiDung   NguoiDungs @relation(fields: [maNguoiDung], references: [id])
  maTinTuc    Int
  tinTuc      TinTucs    @relation(fields: [maTinTuc], references: [id])
  ngayThem    DateTime   @default(now())
  
  @@unique([maNguoiDung, maTinTuc])
}

// Đơn hàng
model Order {
  id              Int           @id @default(autoincrement())
  maNguoiDung     Int
  nguoiDung       NguoiDungs    @relation(fields: [maNguoiDung], references: [id])
  tongTien        Int
  trangThai       String        @default("pending") // pending, completed, cancelled
  ngayTao         DateTime      @default(now())
  ngayCapNhat     DateTime      @updatedAt
  orderItems      OrderItem[]
  payment         Payment?
}

// Chi tiết đơn hàng
model OrderItem {
  id        Int      @id @default(autoincrement())
  maOrder   Int
  order     Order    @relation(fields: [maOrder], references: [id])
  maTinTuc  Int
  tinTuc    TinTucs  @relation(fields: [maTinTuc], references: [id])
  gia       Int
  ngayTao   DateTime @default(now())
}

// Thanh toán
model Payment {
  id              Int      @id @default(autoincrement())
  maOrder         Int      @unique
  order           Order    @relation(fields: [maOrder], references: [id])
  phuongThuc      String   // wallet, bank_transfer, redeem_code
  soTien          Int
  trangThai       String   @default("pending") // pending, success, failed
  transactionId   String?
  ngayThanhToan   DateTime @default(now())
}

// Mã giảm giá / Redeem code
model RedeemCode {
  id            Int              @id @default(autoincrement())
  code          String           @unique
  loaiCode      String           // single_post, balance
  giaTri        Int              // Giá trị: ID bài viết hoặc số tiền
  soLanDung     Int              @default(1)
  daDung        Int              @default(0)
  ngayTao       DateTime         @default(now())
  ngayHetHan    DateTime?
  nguoiTao      Int
  creator       NguoiDungs       @relation(fields: [nguoiTao], references: [id])
  trangThai     Boolean          @default(true)
  usedBy        RedeemCodeUsage[]
  postSubmission PostSubmission? @relation("PostSubmissionCode")
}

// Lịch sử dùng code
model RedeemCodeUsage {
  id          Int        @id @default(autoincrement())
  maCode      Int
  code        RedeemCode @relation(fields: [maCode], references: [id])
  maNguoiDung Int
  nguoiDung   NguoiDungs @relation(fields: [maNguoiDung], references: [id])
  ngayDung    DateTime   @default(now())
  
  @@unique([maCode, maNguoiDung])
}

// Ví tiền người dùng
model Wallet {
  id          Int      @id @default(autoincrement())
  maNguoiDung Int      @unique
  nguoiDung   NguoiDungs @relation(fields: [maNguoiDung], references: [id])
  soDu        Int      @default(0)
  ngayTao     DateTime @default(now())
  ngayCapNhat DateTime @updatedAt
  transactions WalletTransaction[]
}

// Lịch sử giao dịch ví
model WalletTransaction {
  id          Int      @id @default(autoincrement())
  maVi        Int
  wallet      Wallet   @relation(fields: [maVi], references: [id])
  loaiGD      String   // deposit, withdraw, purchase
  soTien      Int
  moTa        String?
  ngayGD      DateTime @default(now())
}

// Bài viết đã mua
model PurchasedPost {
  id          Int      @id @default(autoincrement())
  maNguoiDung Int
  nguoiDung   NguoiDungs @relation(fields: [maNguoiDung], references: [id])
  maTinTuc    Int
  tinTuc      TinTucs    @relation(fields: [maTinTuc], references: [id])
  ngayMua     DateTime   @default(now())
  gia         Int
  
  @@unique([maNguoiDung, maTinTuc])
}

// Bài viết chờ duyệt
model PostSubmission {
  id              Int          @id @default(autoincrement())
  tieuDe          String
  noiDung         String       @db.LongText
  hinhAnh         String?
  isPremium       Boolean      @default(false)
  maNguoiDung     Int
  nguoiDung       NguoiDungs   @relation(fields: [maNguoiDung], references: [id])
  maDanhMuc       Int?
  danhMuc         DanhMucs?    @relation(fields: [maDanhMuc], references: [id])
  trangThai       String       @default("pending") // pending, approved, rejected
  maCodeTao       Int?         @unique
  redeemCode      RedeemCode?  @relation("PostSubmissionCode", fields: [maCodeTao], references: [id])
  ngayGui         DateTime     @default(now())
  ngayDuyet       DateTime?
  nguoiDuyet      Int?
  ghiChu          String?
}

// Bookmark - Lưu trữ yêu thích bài viết
model Bookmark {
  id          Int        @id @default(autoincrement())
  maNguoiDung Int
  nguoiDung   NguoiDungs @relation(fields: [maNguoiDung], references: [id])
  maTinTuc    Int
  tinTuc      TinTucs    @relation(fields: [maTinTuc], references: [id])
  ngayLuu     DateTime   @default(now())
  
  @@unique([maNguoiDung, maTinTuc])
}

// Rating - Đánh giá bài viết (like/rating)
model Rating {
  id          Int        @id @default(autoincrement())
  maNguoiDung Int
  nguoiDung   NguoiDungs @relation(fields: [maNguoiDung], references: [id])
  maTinTuc    Int
  tinTuc      TinTucs    @relation(fields: [maTinTuc], references: [id])
  rating      Int        @default(1) // 1-5 stars hoặc chỉ dùng 1 cho "like"
  ngayDanhGia DateTime   @default(now())
  
  @@unique([maNguoiDung, maTinTuc])
}
// Follow - Theo dõi tác giả
model Follow {
  id              Int        @id @default(autoincrement())
  maNguoiDungTheoDoi Int
  nguoiDungTheoDoi NguoiDungs @relation("FollowerOf", fields: [maNguoiDungTheoDoi], references: [id])
  maNguoiDungTacGia Int
  nguoiDungTacGia  NguoiDungs @relation("Author", fields: [maNguoiDungTacGia], references: [id])
  ngayTheo         DateTime   @default(now())
  
  @@unique([maNguoiDungTheoDoi, maNguoiDungTacGia])
}